{{- $rust := get . "rust" | default dict -}}
{{- if and (get $rust "enable" | default (eq .chezmoi_profile "full")) (eq .chezmoi.os "linux") -}}
{{- $programs_directory := get . "programs_directory" | default (joinPath .chezmoi.homeDir ".local") -}}
{{- $cargo_home := get $rust "cargo_home" | default (joinPath $programs_directory "cargo") -}}
{{- $rustup_home := get $rust "rustup_home" | default (joinPath $programs_directory "rustup") -}}

#!/bin/sh

set -eu

export CARGO_HOME={{ $cargo_home | quote }}
export RUSTUP_HOME={{ $rustup_home | quote }}

{{- if or (eq .chezmoi.osRelease.id "debian") (eq .chezmoi.osRelease.id "ubuntu") }}

# Update packages
sudo apt update

{{ include "install_packages/rust/ubuntu_debian" }}

{{- end }}

curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --no-modify-path

. "${CARGO_HOME}/env"

{{- $c_cpp := get . "c_cpp" | default dict -}}
{{- $neovim := get . "neovim" | default dict -}}
{{- if and (get $c_cpp "enable" | default false) (get $c_cpp "development" | default false) (get $neovim "enable" | default false) }}

# Install C/C++ Neovim tools
if ! command -v neocmakelsp >/dev/null 2>&1; then
    cargo install neocmakelsp
fi

{{- end }}

{{- if get $neovim "enable" | default false }}

# Install Neovim tools
if ! command -v tree-sitter >/dev/null 2>&1; then
    cargo install --locked tree-sitter-cli
fi

{{- end }}

{{- end }}
