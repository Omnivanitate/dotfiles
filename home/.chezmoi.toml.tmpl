{{- /*
This template generates the machine-specific part of the chezmoi config.
Only machine-computed values (profile, directories, shell) are written here:
personal and per-host data belongs in .chezmoidata.toml and
.chezmoidata.<hostname>.toml, which take effect on top of this file.
*/ -}}

{{- $local_chezmoi_profile := env "CHEZMOI_PROFILE" | default "default" -}}

{{- $local_home_dir := "" -}}
{{- $local_config_dir := "" -}}
{{- $local_programs_dir := "" -}}
{{- $local_sources_codes_dir := "" -}}

{{- if eq .chezmoi.os "linux" -}}
{{- $local_home_dir = "${HOME}" -}}
{{- $local_config_dir = joinPath $local_home_dir ".config" -}}
{{- $local_programs_dir = joinPath $local_home_dir ".local" -}}
{{- $local_sources_codes_dir = joinPath $local_home_dir ".sources_codes" -}}
{{- end -}}

{{- $zsh := get . "zsh" | default dict -}}
{{- $enable_zsh := get $zsh "enable" | default (eq $local_chezmoi_profile "full" "default") -}}
{{- $shell := "" -}}
{{- if $enable_zsh -}}
{{- $shell = "zsh" -}}
{{- end -}}

# Generated config

[data]
chezmoi_profile = {{ $local_chezmoi_profile | quote }}
sources_codes_directory = {{ $local_sources_codes_dir | quote }}
programs_directory = {{ $local_programs_dir | quote }}
configuration_directory = {{ $local_config_dir | quote }}
shell = {{ $shell | quote }}
{{- if eq $shell "zsh" }}
os_user_profile_path = {{ joinPath $local_home_dir ".zsh_profile" | quote }}
{{- else }}
os_user_profile_path = ""
{{- end }}
