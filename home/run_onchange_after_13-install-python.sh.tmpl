{{- $python := get . "python" | default dict -}}
{{- if get $python "enable" | default (eq .chezmoi_profile "full") -}}
{{- if eq .chezmoi.os "linux" -}}
#!/bin/sh

set -eu

{{ if eq .chezmoi.osRelease.id "debian" "ubuntu" -}}
sudo apt update
{{ include "install_packages/python/ubuntu_debian" -}}
{{- end }}

{{- $local_programs_dir := get . "programs_directory" | default (joinPath .chezmoi.homeDir ".local") -}}
{{- $pyenv := get $python "pyenv" | default dict -}}
{{- $uv := get $python "uv" | default dict -}}

{{- if get $pyenv "enable" | default false }}
if command -v pyenv >/dev/null 2>&1; then
    echo "pyenv already installed"
    pyenv --version
else
    PYENV_DIR={{ get $pyenv "program_directory" | default (joinPath $local_programs_dir "pyenv") | quote }}
    mkdir -p "${PYENV_DIR}"
    git clone https://github.com/pyenv/pyenv.git "${PYENV_DIR}"
    cd "${PYENV_DIR}"
    src/configure && make -C src
fi
{{- end }}

{{- if get $uv "enable" | default false }}

if command -v uv >/dev/null 2>&1; then
    echo "uv already installed"
    uv --version
else
    curl -LsSf https://astral.sh/uv/install.sh | sh
fi
{{- end }}

{{- end }}
{{- end }}
