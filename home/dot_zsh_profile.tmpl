export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

export SOURCES_CODES={{- get . "sources_codes" | default (joinPath "${HOME}" ".sources_codes") | quote }}
export PROGRAMS_DIRECTORY={{- get . "programs_directory" | default (joinPath "${HOME}" ".local") | quote }}

export ZSH={{- joinPath "${PROGRAMS_DIRECTORY}" "oh-my-zsh" | quote }}

export LANG="{{ get . "lang" | default "C.UTF-8" }}"
export LC_ALL="{{ get . "lc_all" | default "C.UTF-8" }}"

{{ if .zsh.enable -}}
#zsh
ZSH_CACHE_DIR={{- get (get . "zsh" | default dict) "cache" | default (joinPath "${XDG_CACHE_HOME}" "zsh") | quote }}
if [[ ! -d "${ZSH_CACHE_DIR}" ]]; then
    mkdir -p "${ZSH_CACHE_DIR}"
fi
ZSH_COMPDUMP="${ZSH_CACHE_DIR:-$HOME/.cache/zsh}/zcompdump-${SHORT_HOST}-${ZSH_VERSION}"
autoload -Uz compinit
compinit -d "${ZSH_COMPDUMP}"

export HISTFILE={{ get (get . "zsh" | default dict) "histfile" | default (joinPath "$ZSH_CACHE_DIR" "history") | quote }}
{{- end }}

{{ if .tmux.enable -}}
#tmux
alias tmux="TERM=screen-256color-bce tmux"
{{- end }}

{{ $rust := get . "rust" | default dict -}}
{{ if get $rust "enable" | default false -}}
#rust
{{ if get $rust "cargo_home" -}}
. {{ joinPath (get $rust "cargo_home") "env" }}
{{- end }}
{{- end }}

{{ if .neovim.enable -}}
NVIM_PROGRAM_DIR={{get (get . "neovim" | default dict) "program_directory" | default (joinPath "${PROGRAMS_DIRECTORY}" "nvim") | quote }}
export PATH="${NVIM_PROGRAM_DIR}/bin:${PATH}" 

#chezmoi
export EDITOR="${NVIM_PROGRAM_DIR}/bin/nvim"
{{- end }}

{{if and .python.enable .python.pyenv.enable -}}
PYENV_ROOT={{ .python.pyenv.program_directory }}
export PYENV_ROOT=${PYENV_ROOT:-${HOME}/.local/pyenv}
export PATH="${PYENV_ROOT}/bin:${PATH}"
eval "$(pyenv init -)"
{{- end }}
