{{- $ai := get . "ai" | default dict -}}
{{- if and (get $ai "enable" | default (eq .chezmoi_profile "full" "default")) (eq .chezmoi.os "linux") -}}
{{- $local_home_dir := "${HOME}" -}}
{{- $local_programs_directory := get . "programs_directory" | default (joinPath $local_home_dir ".local") -}}
#!/bin/sh

set -eu

export OPENCODE_HOME={{ get $ai "opencode_home" | default (joinPath $local_programs_directory "opencode") | quote }}

mkdir -p "${OPENCODE_HOME}/bin"

# Install OpenCode 2 into ${OPENCODE_HOME}/bin instead of the default ~/.opencode/bin
curl -fsSL https://opencode.ai/v2/install |
    sed 's|^INSTALL_DIR=.*|INSTALL_DIR=${OPENCODE_HOME}/bin|' |
    bash -s -- --no-modify-path

"${OPENCODE_HOME}/bin/opencode" --version

{{- end }}
